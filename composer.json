{
    "name": "yazilim360/laravel-media-manager",
    "type": "library",
    "description": "Modern Vue 3 media manager for Laravel (Spatie MediaLibrary): folders, crop & theme variants, lightbox with video, light/dark theming, drag & drop upload.",
    "license": "MIT",
    "authors": [
        {
            "name": "Ismet Ertekin",
            "email": "ismet.ertekin@yazilim360.com.tr"
        }
    ],
    "autoload": {
        "psr-4": {
            "Yazilim360\\MediaManager\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "php-ffmpeg/php-ffmpeg": "^1.2",
        "spatie/laravel-medialibrary": "^11",
        "illuminate/support": ">=10|^11|^12|^13"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yazilim360\\MediaManager\\MediaManagerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "suggest": {
        "ext-exif": "Reads the EXIF orientation of JPEG photos so rotated phone photos are cropped correctly",
        "ext-imagick": "Not required (image processing uses GD)"
    }
}
